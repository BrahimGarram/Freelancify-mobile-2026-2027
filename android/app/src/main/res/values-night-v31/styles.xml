<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de la fenêtre pendant le démarrage : fond noir et logo -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12 et plus : écran de lancement du système -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
    <!-- Noir aussi derrière Flutter : pas de flash blanc au démarrage -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
